# ---- runtime ----
NODE_ENV=development
PORT=2900
HOST=0.0.0.0
LOG_LEVEL=info

# Identidade deste nó no cluster. Em produção use o hostname do pod/container.
# Se ficar vazio, o AWAH deriva do hostname da máquina.
NODE_ID=

# ---- dados ----
DATABASE_URL=postgres://awah:awah@localhost:5432/awah
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# ---- segredos ----
# Cifra o auth state das sessões em repouso (AES-256-GCM).
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# Assina os cookies de sessão do dashboard. Mínimo de 32 caracteres.
# Gere com: openssl rand -base64 48
COOKIE_SECRET=

# ---- sessão do dashboard ----
SESSION_TTL_HOURS=168

# ---- engine de WhatsApp ----
# Log da engine, separado do log da API. O Baileys é muito verboso em debug —
# suba para 'debug' quando uma sessão se recusar a parear.
ENGINE_LOG_LEVEL=silent

# Tentativas de reconexão antes de o gerenciador desistir de uma sessão.
MAX_RECONNECT_ATTEMPTS=10

# ---- bootstrap ----
# Quando true, a rota POST /v1/auth/register cria a primeira org e o primeiro
# usuário. Depois disso o registro aberto fecha sozinho.
ALLOW_OPEN_REGISTRATION=true

# ---- painel ----
# Onde estão os arquivos do dashboard. Vazio, a API procura em public,
# apps/api/public, ../web/dist e apps/web/dist, nessa ordem — e sobe sem painel
# se não achar nenhum. A imagem Docker já vem com o caminho definido.
DASHBOARD_DIR=

# ---- telemetria ----
# Protege /metrics. Sem ele a URL entrega volume de mensagens, número de sessões
# e saúde da operação a quem alcançar a porta. Mínimo de 16 caracteres.
METRICS_TOKEN=

# ---- motor de risco ----
# Desligar dispara na velocidade máxima da fila, que é o comportamento que
# derruba chip. Só use com número descartável.
RISK_ENGINE_ENABLED=true
