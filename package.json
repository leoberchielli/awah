{
  "name": "awah",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Gateway de WhatsApp com fila dur\u00e1vel, motor de risco e sess\u00f5es em cluster",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @awah/api dev",
    "dev:web": "pnpm --filter @awah/web dev",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "pnpm --filter @awah/db generate",
    "db:migrate": "pnpm --filter @awah/db migrate",
    "db:studio": "pnpm --filter @awah/db studio",
    "i18n:check": "node scripts/i18n-check.mjs",
    "contrast:check": "node scripts/contrast-check.mjs",
    "bench": "node scripts/benchmark.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:cluster": "node scripts/verify-cluster.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "typescript": "^5.7.3"
  }
}
